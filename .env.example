# 服务端知乎数据开放平台凭证
ZHIHU_ACCESS_SECRET=

# OAuth 应用获批后再填写；三个变量必须同时设置
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://xieyao-meow.babelbeast.com/api/auth/zhihu/callback

# 路演/排练专用：只由服务端环境控制 Journey 时间缩放；正式体验保持 1
# 例如 0.02 会把首趟 3–5 分钟压到约 4–6 秒。客户端无法通过 query/body 快进。
XIEYAO_REHEARSAL_JOURNEY_TIME_SCALE=1

# 本地运行端口（可选）
PORT=3000
